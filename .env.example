# ──────────────────────────────────────────────────
# REQUIRED ENVIRONMENT VARIABLES FOR IITBNF SERVER
# Copy this file to `.env` and fill in actual values.
# ──────────────────────────────────────────────────

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_password

# Database schemas (4 separate MySQL databases)
DB1=slotbooking           # login, resources (eqp-process), lab_incharge
DB2=facility_management   # resources (facility)
DB3=safety                # safety_device
DB4=iitbnf_troubleshooting  # equipment_complaint, conversation_state, chatbot_error_logs, complaint_it_keywords

# Twilio WhatsApp Configuration
# Find these in the Twilio Console -> Account Info
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=abcd...

# Gemini / Google Generative AI Configuration
# Create a free key at https://aistudio.google.com
GEMINI_API_KEY=AIza...

# PHP Backend Processing Integration
# URL for inserting complaints via the IT team's PHP endpoint
PHP_API_URL=http://localhost/api/insert_complaint_api.php
PHP_API_TOKEN=iitbnf_api_7YxF2P9h

# Local Server Configuration
PORT=8000
